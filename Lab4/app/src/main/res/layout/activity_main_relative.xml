<?xml version="1.0" encoding="utf-8"?>
<!-- The same first screen built with RelativeLayout. Every view is placed relative to the parent or a sibling.
     It uses the same ids as activity_main.xml so one Java class can drive both layouts. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".RelativeMainActivity">

    <!-- Top of the parent, centred horizontally -->
    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/avatar_description"
        android:src="@drawable/avatar" />

    <!-- Invisible zero height anchor in the vertical centre of the parent -->
    <View
        android:id="@+id/centerAnchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerVertical="true" />

    <!-- Sits just above the centre anchor, centred horizontally -->
    <TextView
        android:id="@+id/lblName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/centerAnchor"
        android:layout_centerHorizontal="true"
        android:labelFor="@id/txtName"
        android:text="@string/enter_name"
        android:textSize="12sp" />

    <!-- Below the label, full width -->
    <EditText
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/lblName"
        android:layout_marginTop="8dp"
        android:hint="@string/name_hint"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:textSize="14sp" />

    <!-- Bottom of the parent, full width -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/submit_purple"
        android:text="@string/submit"
        android:textAllCaps="true"
        app:cornerRadius="4dp" />

</RelativeLayout>
