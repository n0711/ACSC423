<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lab3UserInterface">

        <!-- singleTop so the back arrow on each example returns to this same screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- parentActivityName adds the back arrow to the action bar of each example -->
        <activity
            android:name=".LinearLayoutActivity"
            android:label="@string/title_linear_layout"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".WeightGravityActivity"
            android:label="@string/title_weight_gravity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".NestedLinearLayoutActivity"
            android:label="@string/title_nested_linear_layout"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RelativeLayoutActivity"
            android:label="@string/title_relative_layout"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ConstraintLayoutActivity"
            android:label="@string/title_constraint_layout"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
