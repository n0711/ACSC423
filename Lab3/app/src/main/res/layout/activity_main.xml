<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen. ScrollView is one of the ViewGroups from slide 3, it keeps the list usable on small screens -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/home_intro"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <Button
            android:id="@+id/btnLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_linear_layout" />

        <Button
            android:id="@+id/btnWeightGravity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_weight_gravity" />

        <Button
            android:id="@+id/btnNestedLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_nested_linear_layout" />

        <Button
            android:id="@+id/btnRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_relative_layout" />

        <Button
            android:id="@+id/btnConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_constraint_layout" />
    </LinearLayout>
</ScrollView>
