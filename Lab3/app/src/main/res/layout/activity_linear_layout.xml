<?xml version="1.0" encoding="utf-8"?>
<!-- Slide 4. The LinearLayout arranges its children in a single column (orientation vertical) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".LinearLayoutActivity">

    <!-- match_parent: the TextView fills the entire width of its parent
         wrap_content: its height is the height of its content -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hello" />

</LinearLayout>
