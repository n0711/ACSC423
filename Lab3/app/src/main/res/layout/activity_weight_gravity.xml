<?xml version="1.0" encoding="utf-8"?>
<!-- Slide 7. layout_gravity says where each button sits, layout_weight says how the free height is shared.
     The buttons get 1/(1+2+3) = 16.6%, 2/(1+2+3) = 33.3% and 3/(1+2+3) = 50% of the height.
     Each height is 0dp because the orientation is vertical, so the weights decide it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".WeightGravityActivity">

    <Button
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_gravity="left"
        android:layout_weight="1"
        android:text="@string/button" />

    <Button
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="2"
        android:text="@string/button" />

    <Button
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_gravity="right"
        android:layout_weight="3"
        android:text="@string/button" />

</LinearLayout>
